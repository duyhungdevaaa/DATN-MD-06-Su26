<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trend_bg"
    android:padding="28dp"
    tools:context=".activity.OtpVerificationActivity">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        app:tint="@color/trend_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xác minh số điện thoại"
        android:textColor="@color/trend_text"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/ivBack"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Đã gửi mã xác nhận đến\n09xxxxxxxx"
        android:textColor="@color/trend_muted"
        android:textSize="15sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/otpContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/tvDescription">

        <EditText
            android:id="@+id/etOtp1"
            style="@style/OtpEditText"
            android:nextFocusForward="@id/etOtp2" />

        <EditText
            android:id="@+id/etOtp2"
            style="@style/OtpEditText"
            android:nextFocusForward="@id/etOtp3" />

        <EditText
            android:id="@+id/etOtp3"
            style="@style/OtpEditText"
            android:nextFocusForward="@id/etOtp4" />

        <EditText
            android:id="@+id/etOtp4"
            style="@style/OtpEditText"
            android:nextFocusForward="@id/etOtp5" />

        <EditText
            android:id="@+id/etOtp5"
            style="@style/OtpEditText"
            android:nextFocusForward="@id/etOtp6" />

        <EditText
            android:id="@+id/etOtp6"
            style="@style/OtpEditText" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="60s"
        android:textColor="@color/trend_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/otpContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="XÁC MINH"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/black"
        app:cornerRadius="2dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvCountdown" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResend"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="GỬI LẠI MÃ OTP"
        android:textColor="@color/trend_text"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/trend_bg"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:strokeColor="@color/trend_border"
        app:strokeWidth="1dp"
        app:cornerRadius="2dp"
        android:layout_marginTop="12dp"
        android:enabled="false"
        app:layout_constraintTop_toBottomOf="@id/btnVerify" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/trend_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
