<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingVertical="12dp"
    android:paddingHorizontal="8dp">

    <CheckBox
        android:id="@+id/cbSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#EE4D2D"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:layout_constraintBottom_toBottomOf="@id/ivItemImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivItemImage" />

    <androidx.cardview.widget.CardView
        android:id="@+id/ivCard"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginStart="4dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toEndOf="@id/cbSelect"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_shopping_bag" />
    </androidx.cardview.widget.CardView>
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivItemImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="8dp"
        android:background="#EEEEEE"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_shopping_bag"
        app:layout_constraintStart_toEndOf="@id/cbSelect"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Tên sản phẩm"
        android:textColor="#333333"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivCard"
        app:layout_constraintTop_toTopOf="@id/ivCard" />

    <LinearLayout
        android:id="@+id/layoutVariant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:background="#F8F8F8"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toEndOf="@id/ivCard"
        app:layout_constraintTop_toBottomOf="@id/tvItemName">

        <TextView
            android:id="@+id/tvItemVariant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phân loại hàng: Đen, M"
            android:textColor="#888888"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#888888" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:text="đ1.890.000"
        android:textColor="#EE4D2D"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivCard"
        app:layout_constraintStart_toEndOf="@id/ivCard" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:background="@drawable/bg_button_outline"
        android:backgroundTint="#F0F0F0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/ivCard"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnDecrease"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="−"
            android:textColor="#333333"
            android:textSize="14sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textColor="#333333"
            android:textSize="13sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <TextView
            android:id="@+id/btnIncrease"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="+"
            android:textColor="#333333"
            android:textSize="14sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toBottomOf="@id/ivCard" />

</androidx.constraintlayout.widget.ConstraintLayout>