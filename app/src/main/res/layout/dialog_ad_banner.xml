<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivAdBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_shopping_bag" />

            <!-- Dim overlay to make close button pop -->
            <View
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_gradient_top_shadow" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Floating Close Button at Top-Right -->
    <ImageView
        android:id="@+id/ivCloseAd"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_circle_white"
        android:elevation="10dp"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        app:tint="@color/black"
        app:layout_constraintTop_toTopOf="@id/cvBannerContainer"
        app:layout_constraintEnd_toEndOf="@id/cvBannerContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
